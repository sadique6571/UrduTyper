<?xml version="1.0" encoding="utf-8"?>
<!-- Layers panel bottom sheet (Canva phase 4). Honest scope: the editor has
     exactly two layers — Text (top) and Background (bottom). Rows are listed
     top-first (z-order). No reorder: with two fixed layers there is no other
     order that keeps the text visible, and there is no image layer yet (it
     would need the HD render pipeline to change too). -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/dialog_sheet_bg"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Layers"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Text layer (top). Tap the row to edit the text. -->
        <LinearLayout
            android:id="@+id/layersTextRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text (oopar)"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/layersTextPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted_dark"
                    android:textSize="14sp" />

            </LinearLayout>

            <Switch
                android:id="@+id/layersTextSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <!-- Background layer (bottom). Tap the row to open Background. -->
        <LinearLayout
            android:id="@+id/layersBackgroundRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Background (neeche)"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/layersBackgroundName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted_dark"
                    android:textSize="14sp" />

            </LinearLayout>

            <Switch
                android:id="@+id/layersBackgroundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            android:text="Background hamesha neeche, Text oopar — tartib badli nahi ja sakti."
            android:textAlignment="center"
            android:textColor="@color/text_muted_dark"
            android:textSize="13sp" />

    </LinearLayout>
</layout>
