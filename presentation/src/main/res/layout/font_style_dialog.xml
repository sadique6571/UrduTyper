<?xml version="1.0" encoding="utf-8"?>
<!-- Font style bottom sheet: dark rewrite. Same ids as before (fontSize,
     alignLeft, alignCenter, alignRight, autoTextColor, textColor, myFont,
     bold, italic) so TypeFragment is untouched. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/dialog_sheet_bg"
        android:gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Font Style"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/fontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="80"
            android:progress="30"
            android:progressBackgroundTint="@color/text_muted_dark"
            android:progressTint="@color/gradient_purple"
            android:thumbTint="@color/accent_lime"
            android:tooltipText="Text Size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Text Size"
            android:textAlignment="center"
            android:textColor="@color/text_muted_dark"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/align_left"
                android:tooltipText="Align Left"
                app:backgroundTint="@color/gradient_indigo"
                app:elevation="0dp"
                app:fab_colorPressed="@color/buttonPressed"
                app:maxImageSize="30dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/align_center"
                android:tooltipText="Align Center"
                app:backgroundTint="@color/gradient_indigo"
                app:elevation="0dp"
                app:fab_colorPressed="@color/buttonPressed"
                app:maxImageSize="30dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/alignRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/align_right"
                android:tooltipText="Align Right"
                app:backgroundTint="@color/gradient_indigo"
                app:elevation="0dp"
                app:fab_colorPressed="@color/buttonPressed"
                app:maxImageSize="30dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/autoTextColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/auto_color"
                android:tooltipText="Random Text Color"
                app:backgroundTint="@color/gradient_indigo"
                app:elevation="0dp"
                app:fab_colorPressed="@color/buttonPressed"
                app:maxImageSize="30dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/textColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/font_color"
                android:tooltipText="Text Color"
                app:backgroundTint="@color/gradient_indigo"
                app:elevation="0dp"
                app:fab_colorPressed="@color/buttonPressed"
                app:maxImageSize="30dp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/myFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_outline_font_download_24"
            android:tooltipText="Font"
            app:backgroundTint="@color/gradient_indigo"
            app:elevation="0dp"
            app:fab_colorPressed="@color/buttonPressed"
            app:maxImageSize="30dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:buttonTint="@color/gradient_purple"
                android:text="Bold"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/italic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Italic"
                android:textColor="@color/white"
                android:textStyle="italic" />

        </LinearLayout>

    </LinearLayout>
</layout>
