<?xml version="1.0" encoding="utf-8"?>
<!-- Text effect bottom sheet (Photoshop-style bevel). Tap an effect to apply
     it at once. The HD export draws the full bevel; the editor shows a hint. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@drawable/dialog_sheet_bg"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Text Effect"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

            <RadioButton
                android:id="@+id/effectNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Simple (koi effect nahi)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectEmboss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Emboss (ubhra hua)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectEngrave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Engrave (khuda hua)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectGlow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Glow (chamak)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectOutline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Outline (khaka)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectGradient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Gradient (rangeen)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectDropShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Drop Shadow (neeche saaya)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectNeon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Neon (tez chamak)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effect3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="3D Text (gehra)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectLongShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Long Shadow (lambi chhaya)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectGradientH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Gradient Horizontal"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectGradientD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Gradient Diagonal"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectGradientGold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Gradient Gold"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectGradientRainbow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Gradient Rainbow"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectInnerShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Inner Shadow (andar saaya)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectInnerGlow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Inner Glow (andar chamak)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectPatternFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Pattern Fill (design bhara)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/effectReflection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/gradient_purple"
                android:text="Reflection (aks)"
                android:textColor="@color/white"
                android:textSize="17sp" />

            </RadioGroup>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            android:text="Note: HD save mein tamam effects poore aayenge; editor mein bevel ki jhalak, outline sirf khaka, 3D / long shadow ka sirf ishara, inner shadow / inner glow ka halka kinara nazar aayega, aur reflection sirf HD mein aayega. Pattern fill editor mein bhi poora dikhta hai. Normal save editor jaisa hi rehta hai."
            android:textAlignment="center"
            android:textColor="@color/text_muted_dark"
            android:textSize="13sp" />

    </LinearLayout>
</layout>
